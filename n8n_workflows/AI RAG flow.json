      "parameters": {
        "jsCode": "// Получаем все входящие элементы\nconst items = $input.all();\n\n// Проверяем, есть ли хотя бы в одном элементе поле \"error\"\nconst hasError = items.some(item => item.json && item.json.error !== undefined);\n\n// Получаем текст ошибки (если она есть)\nconst errorMessage = items.find(item => item.json?.error)?.json?.error?.message || null;\n\nreturn [{\n  json: {\n    hasError: hasError,\n    errorMessage: errorMessage\n  }\n}];"
