    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Use this tool to find financial metrics, budget data, inflation percentages, and economic numbers from the Fairy Tail kingdom, Magnolia city, and various magic guilds.",
        "qdrantCollection": {
          "__rl": true,
          "value": "fairy_tail_base",
          "mode": "list",
          "cachedResultName": "fairy_tail_base"
        },
        "options": {}
