      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        448,
        288
      ],
      "id": "f1c5f54f-1c89-4085-92e6-0395681caf44",
      "name": "Qdrant Vector Store",
      "credentials": {
        "qdrantApi": {
          "id": "EGnHpu3p9HIbmIZC",
          "name": "Qdrant account"
        }
