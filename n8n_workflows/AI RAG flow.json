    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst steps = item.intermediateSteps || [];\n\nconst pageContents = [];\n\n// Вспомогательная функция для глубокого поиска pageContent\nfunction extractPageContent(data) {\n  if (!data) return;\n\n  if (typeof data === 'string') {\n    // Пробуем распарсить строку, если внутри зашифрован JSON\n    try {\n      const parsed = JSON.parse(data);\n      extractPageContent(parsed);\n    } catch (e) {\n      // Игнорируем строки с ошибками воркфлоу\n      if (data.includes('pageContent')) {\n        const match = data.match(/\"pageContent\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\n        if (match && match[1]) {\n          pageContents.push(JSON.parse(`\"${match[1]}\"`));\n        }\n      }\n    }\n    return;\n  }\n\n  if (Array.isArray(data)) {\n    data.forEach(extractPageContent);\n  } else if (typeof data === 'object') {\n    // Если объект содержит поле pageContent\n    if (data.pageContent) {\n      pageContents.push(data.pageContent);\n    }\n    // Рекурсивно проходим по всем ключам объекта\n    Object.keys(data).forEach(key => {\n      if (key !== 'metadata') { // Игнорируем метаданные (blob, lines, etc.)\n        extractPageContent(data[key]);\n      }\n    });\n  }\n}\n\n// Проходим по всем шагам агента\nsteps.forEach(step => extractPageContent(step.observation));\n\n// Объединяем найденный чистый текст\nlet cleanContext = [...new Set(pageContents)].join('\\n\\n---\\n\\n').trim();\n\n// Защита для min_length=10 на случай пустой выдачи\nif (cleanContext.length < 10) {\n  cleanContext = \"Контекст из векторной базы знаний Qdrant не найден для данного запроса.\";\n}\n\nreturn {\n  json: {\n    output: item.output || '',\n    context: cleanContext\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "id": "5cd10a80-5cf7-42ef-9bdc-98301cdeaeef",
      "name": "Normalize data"
    },
    {
      "parameters": {
        "description": "Use this tool to save the retrieved context from Qdrant into workflow variables. Call this after using the Qdrant search tool.",
        "jsCode": "// Этот tool вызывается после Qdrant и сохраняет контекст\nconst contexts = $input.all();\nlet cleanContext = \"\";\n\nfor (const item of contexts) {\n  if (item.json.pageContent) {\n    cleanContext += item.json.pageContent + \"\\n\\n\";\n  }\n}\n\n// Сохраняем в переменную workflow\n$workflow.setVariable('rag_context', cleanContext);\n\nreturn {\n  json: {\n    context_saved: true,\n    length: cleanContext.length\n  }\n}"
      },
